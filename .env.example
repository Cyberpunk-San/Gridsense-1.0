# .env.example
# Copy this to .env and fill in your actual values
# NEVER commit .env to git!

# Zoho Accounts (region-specific - use .in for India, .com for US, .eu for EU)
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in

# OAuth credentials from Zoho API Console (Self Client)
# Scope: QuickML.deployment.READ
ZOHO_CLIENT_ID=your_client_id_here
ZOHO_CLIENT_SECRET=your_client_secret_here
ZOHO_REFRESH_TOKEN=your_refresh_token_here

# QuickML Published Endpoint
# Get from QuickML Console → Endpoints → Copy URL and Key
QUICKML_ENDPOINT_URL=https://quickml.catalyst.zoho.in/baas/v1/project/.../endpoint/.../predict
QUICKML_ENDPOINT_KEY=your_endpoint_key_here

# Catalyst Organization
QUICKML_ORG_ID=your_org_id_here
QUICKML_ENV=Development  # or Production

# Optional: Shared key for predict.py proxy endpoint (/api/predict_csv)
# Generate a random string: python -c "import secrets; print(secrets.token_urlsafe(32))"
PREDICT_PROXY_KEY=your_random_shared_key_here